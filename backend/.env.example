# Copy to backend/.env and fill in. Never commit .env.

# --- Gemini ---------------------------------------------------------------
# Pick ONE of the two paths below.
#
# 1. Gemini API (AI Studio) — simplest for local work:
GOOGLE_API_KEY=
#
# 2. Vertex AI — uses Application Default Credentials
#    (`gcloud auth application-default login`). Leave GOOGLE_API_KEY empty.
# USE_VERTEX_AI=true
#
# Region for Gemini specifically. Verified 2026-08-15: gemini-3.7-flash and
# gemini-3.1-pro-preview are served from the GLOBAL endpoint only — regional
# endpoints return 404 NOT_FOUND for them. Keep this separate from GCP_LOCATION,
# which is where the app itself is hosted.
VERTEX_LOCATION=global

# --- Google Cloud ---------------------------------------------------------
# Setting either of these switches storage from local/in-memory to Firestore and
# GCS, and disables ALLOW_DEV_LOGIN. Leave both empty to run entirely locally.
GCP_PROJECT=
GCS_BUCKET=
GCP_LOCATION=us-central1

# --- Auth -----------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI must exactly match OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# Local-only sign-in by email, for running without OAuth. Automatically refused
# whenever GCP_PROJECT or GCS_BUCKET is set, so it cannot be live on a deployment.
ALLOW_DEV_LOGIN=false
