# Copy to backend/.env and fill in. Never commit .env.

# --- Gemini ---------------------------------------------------------------
# Gemini API (AI Studio) path — simplest for local dev:
GOOGLE_API_KEY=
# Vertex AI path instead (needed for gemini-3.1-pro GA); requires gcloud ADC:
# USE_VERTEX_AI=true
# GOOGLE_GENAI_USE_VERTEXAI=true

# --- Google Cloud ---------------------------------------------------------
GCP_PROJECT=
GCP_LOCATION=us-central1
GCS_BUCKET=

# --- OAuth ----------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI must exactly match OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
